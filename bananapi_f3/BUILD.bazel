SPACEMIT_VENDOR_DLKM_MODULES = [
    # DMA
    "mmp_pdma.ko",
    # NOTE: drm_dma_helper / spacemit-drm / spacemit_hdmi /
    # k1x-dma-range / spacemit_ddrbw moved to VENDOR_BOOT_MODULES so
