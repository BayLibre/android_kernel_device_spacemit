# ============================================================
# Filegroups for SELinux contexts
# ============================================================
filegroup(
    name = "system_file_contexts",
    srcs = ["selinux/system_file_contexts"],
)

filegroup(
    name = "file_contexts",
    srcs = ["selinux/file_contexts"],
)

# ============================================================
# Kernel Build
# ============================================================
kernel_build(
    name = "spacemit_k1x",
    srcs = ["//common:kernel_riscv64_sources"],
    outs = [
        "Image",
        "Image.gz",
        "System.map",
        "modules.builtin",
        "modules.builtin.modinfo",
        "vmlinux",
        "vmlinux.symvers",
        # Device Tree Blobs
        "arch/riscv/boot/dts/spacemit/k1-bananapi-f3.dtb",
        "arch/riscv/boot/dts/spacemit/k1-musepi-pro.dtb",
    ],
    arch = "riscv64",
    ddk_module_headers = ["//common:all_headers_riscv64"],
    defconfig = "//common:arch/riscv/configs/gki_defconfig",
    make_goals = [
        "Image",
        "Image.gz",
        "modules",
        "spacemit/k1-bananapi-f3.dtb",
        "spacemit/k1-musepi-pro.dtb",
    ],
    makefile = "//common:Makefile",
    module_outs = get_gki_modules_list("riscv64") +
                  get_kunit_modules_list("riscv64") +
                  SPACEMIT_IN_TREE_MODULES,
    pre_defconfig_fragments = [":spacemit_k1x.fragment"],
    strip_modules = True,
    visibility = ["//visibility:public"],
)

# ============================================================
# Modules Install
# ============================================================
kernel_modules_install(
    name = "spacemit_k1x_modules_install",
    kernel_build = ":spacemit_k1x",
)

# ============================================================
# Module Lists (for Android module loading)
# ============================================================
write_file(
    name = "spacemit_k1x_system_dlkm_modules_list",
    out = "system_dlkm_modules_list",
    content = get_gki_modules_list("riscv64"),
)

write_file(
    name = "spacemit_k1x_vendor_dlkm_modules_list",
    out = "vendor_dlkm_modules.spacemit",
    content = SPACEMIT_VENDOR_DLKM_MODULES,
)

write_file(
    name = "spacemit_k1x_vendor_boot_modules_list",
    out = "vendor_boot_modules.spacemit",
    content = SPACEMIT_VENDOR_BOOT_MODULES,
)

# ============================================================
# Initramfs (vendor_boot ramdisk)
# ============================================================
initramfs(
    name = "spacemit_k1x_initramfs",
    kernel_modules_install = ":spacemit_k1x_modules_install",
    ramdisk_compression = "lz4",
    deps = [":file_contexts"],
    modules_list = ":spacemit_k1x_vendor_boot_modules_list",
    vendor_boot_name = "vendor_boot",
)

# ============================================================
# Vendor DLKM image (ext4 partition with vendor modules)
# ============================================================
vendor_dlkm_image(
    name = "spacemit_k1x_vendor_dlkm_image",
    build_flatten = True,
    kernel_modules_install = ":spacemit_k1x_modules_install",
    modules_list = ":spacemit_k1x_vendor_dlkm_modules_list",
    deps = [":file_contexts"],
)

