# ============================================================
# Vendor Boot modules (essential for first stage init - eMMC access)
# These are loaded from ramdisk during early boot
# Order matters for dependencies!
# ============================================================
SPACEMIT_VENDOR_BOOT_MODULES = [
    # Clock (first - everything depends on it). The CCU core MUST load before the
    # K1 driver: spacemit-ccu.ko exports spacemit_ccu_probe + the *_ops that
    # spacemit-ccu-k1.ko links against (split into core/SoC modules during the
    # android-mainline migration). Loading k1 alone => "Unknown symbol
    # spacemit_ccu_*" => no clocks => pinctrl/mmc/i2c/gpio/usb defer => reboot.
    "spacemit-ccu.ko",
    "spacemit-ccu-k1.ko",
    # Reset (needed early)
    "reset-spacemit-common.ko",
    "reset-spacemit-k1.ko",
    # Pinctrl (GPIO mux - needed for eMMC pins)
    "pinctrl-k1.ko",
    # GPIO
    "gpio-spacemit-k1.ko",
    # I2C (for PMIC)
    "i2c-k1.ko",
    # MFD (PMIC dependency)
    "simple-mfd-i2c.ko",
    # Regulator (PMIC - needed for eMMC power)
    "spacemit-p1.ko",
    # MMC/eMMC (boot device - CRITICAL)
    "sdhci-of-k1.ko",
    # RTC
    "rtc-spacemit-p1.ko",
    # Reboot
    "spacemit-p1-reboot.ko",
    # SoC: DRAM bus stub + DDR AXI bandwidth monitor.
    # Must be available before DPU/HDMI so the interconnect = <&dram_range1>
    # reference in the HDMI DT node resolves.
    "k1x-dma-range.ko",
    "spacemit_ddrbw.ko",
    # DRM stack — moved here so HDMI is up earlier (lets HwComposer / SF
    # start much sooner → bootanim has time to display).
    "drm_dma_helper.ko",
    "spacemit-drm.ko",
    "spacemit_hdmi.ko",
]

