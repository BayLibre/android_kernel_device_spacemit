# Spacemit K1-X Banana Pi F3 device bazelrc
#
# Usage:
#   ln -sf devices/spacemit/spacemit_soc/device.bazelrc device.bazelrc
#   tools/bazel run //devices/spacemit/spacemit_soc:spacemit_k1x_dist
#
# Or with explicit device config:
#   tools/bazel run --config=spacemit_k1x //devices/spacemit/spacemit_soc:spacemit_k1x_dist

# Local build (disable sandboxing). Replaces the obsolete kleaf
# config_repo label_flag, removed during the android-mainline migration.
build:spacemit_k1x --config=local

# RISC-V target platform. @platforms//cpu:riscv64 is only a constraint_value;
# kleaf provides the actual riscv64 platform via the android_riscv64 config.
build:spacemit_k1x --config=android_riscv64
