# Debug GKI overrides — OPT-IN, not wired by default.
#
# KFENCE and PROVE_LOCKING (which selects the whole LOCKDEP / DEBUG_*_MUTEX /
# SPINLOCK / RWSEM family) were moved out of common/arch/riscv/configs/gki_defconfig
# so the default build is non-debug and valid for performance measurement.
#
# To build the debug kernel, add this to the kernel_build target:
#     post_defconfig_fragments = [":spacemit_k1x_debug.fragment"],
CONFIG_KFENCE=y
CONFIG_KFENCE_SAMPLE_INTERVAL=500
CONFIG_KFENCE_NUM_OBJECTS=63
CONFIG_KFENCE_STATIC_KEYS=y
CONFIG_PROVE_LOCKING=y

# Catch a sleeping regmap (syscon mutex) reached from an atomic clk .enable
# under enable_lock: might_sleep() then fires "sleeping function called from
# invalid context" during CCU probe, and the stack
# (ccu_gate_enable/ccu_pll_enable -> regmap -> mutex_lock -> clk_core_enable)
# names the caller.
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_ATOMIC_SLEEP=y

# Cross-hart smp_call diagnostics: csd_lock_wait names the secondary that is
# not acking the IPI, with the function and a backtrace of that CPU, a few
# seconds before an RCU stall would fire. DEFAULT=y arms it without needing
# the csdlock_debug= bootarg, and the shorter stall timeout reports sooner.
CONFIG_CSD_LOCK_WAIT_DEBUG=y
CONFIG_CSD_LOCK_WAIT_DEBUG_DEFAULT=y
CONFIG_RCU_CPU_STALL_TIMEOUT=7
