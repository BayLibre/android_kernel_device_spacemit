# ============================================================
# Vendor Boot modules (essential for first stage init - eMMC access)
# These are loaded from ramdisk during early boot
# Order matters for dependencies!
# ============================================================
SPACEMIT_VENDOR_BOOT_MODULES = [
    # Clock (first - everything depends on it). The CCU core MUST load before the
    # K1 driver: spacemit-ccu.ko exports spacemit_ccu_probe + the *_ops that
    # spacemit-ccu-k1.ko links against (split into core/SoC modules during the
    # android-mainline migration). Loading k1 alone => "Unknown symbol
    # spacemit_ccu_*" => no clocks => pinctrl/mmc/i2c/gpio/usb defer => reboot.
    "spacemit-ccu.ko",
    "spacemit-ccu-k1.ko",
    "spacemit-ccu-k3.ko",
    # Reset (needed early)
    "reset-spacemit-common.ko",
    "reset-spacemit-k1.ko",
    "reset-spacemit-k3.ko",
    # Pinctrl is builtin (=y) on 7.1: the upstream K1 pinctrl driver uses
    # builtin_platform_driver, so it ships in the Image rather than as a .ko.
    # GPIO
    "gpio-spacemit-k1.ko",
    # I2C (for PMIC)
    "i2c-k1.ko",
    # MFD (PMIC dependency)
    "simple-mfd-i2c.ko",
    # Regulator (PMIC - needed for eMMC power)
    "spacemit-p1.ko",
    # MMC/eMMC (boot device - CRITICAL)
    "sdhci-of-k1.ko",
    # UFS — K3 Pico-ITX boot storage (UFS 2.2, no eMMC). SCSI/UFSHCD core +
    # platform glue are builtin (gki_defconfig =y); only the SpacemiT glue is
    # a module. Must be in the ramdisk so the UFS root mounts at first stage.
    # K3-only: no spacemit,k3-ufshcd DT node on K1, so it stays idle there.
    "ufs-spacemit.ko",
    # K3 USB3 combo PHY + Type-C orientation switch (K3-only, deps builtin).
    # In vendor_boot so recovery has USB3 in first stage; dwc3 (generic-plat,
    # builtin) defers until this loads for the USB3 ports.
    "phy-k3-usb3.ko",
    "phy-k3-inno-dp.ko",
    # FUSB301 Type-C DRP controller on i2c1 (K3 Pico-ITX USB-C, K3-only).
    "fusb301.ko",
    # RTC
    "rtc-spacemit-p1.ko",
    # Reboot
    "spacemit-p1-reboot.ko",
    # SoC: DRAM bus stub + DDR AXI bandwidth monitor.
    # Must be available before DPU/HDMI so the interconnect = <&dram_range1>
    # reference in the HDMI DT node resolves.
    "k1x-dma-range.ko",
    "spacemit_ddrbw.ko",
    # DRM stack — moved here so HDMI is up earlier (lets HwComposer / SF
    # start much sooner → bootanim has time to display).
    # fbdev client lib: spacemit-drm links against
    # drm_client_setup_with_color_mode, which lives here. Must be loaded
    # first stage, before spacemit-drm.
    # DP helpers the inno-dp bridge selects; they must precede it.
    "drm_display_helper.ko",
    "drm_dp_aux_bus.ko",
    # The bridge registers as a component and spacemit-drm is the master
    # that calls component_bind_all(), so the bridge loads first.
    "spacemit-inno-dp.ko",
    "spacemit-drm.ko",
]

# ============================================================
# Vendor DLKM modules (loaded after boot from eMMC)
# ============================================================
SPACEMIT_VENDOR_DLKM_MODULES = [
    # DMA
    "mmp_pdma.ko",
    # K3 Audio DMA (DP-audio path) — K3-only, no-op on K1 (no DT node)
    "adma-spacemit.ko",
    # K3 V2D 2D engine (CONFIG_SPACEMIT_V2D=m), binds spacemit,v2d
    "v2d.ko",
    # SoC info / eFuse / SoC boot-mode reboot. Built (=m) but shipped nowhere
    # before; ship them here so second stage has chip info + SoC reboot.
    "spacemit-socinfo.ko",
    "spacemit-efuse.ko",
    "spacemit-k1x-reboot.ko",
    # The display stack (the DP helpers, spacemit-inno-dp and spacemit-drm)
    # lives in VENDOR_BOOT_MODULES so the display is up early enough for
    # SurfaceFlinger / bootanim. The GEM shmem helper is built into vmlinux
    # here and fbdev emulation is off, so neither ships as a module.
    # Ethernet — Realtek RTL8211F PHY (+ PHY_PACKAGE dep) must load before
    # the MAC so the RTL8211F binds instead of the genphy fallback.
    "phy_package.ko",
    "realtek.ko",
    "k1_emac.ko",
    # RFKILL GPIO backend — drives WLAN_EN / BT_EN enable lines (rfkill-pcie-wlan
    # / rfkill-usb-bt DT nodes). rfkill core is GKI (system_dlkm). K3 board only.
    "rfkill-gpio.ko",
    # WiFi — Realtek RTL8852BE (PCIe) on the K3 Pico-ITX M.2 slot. Load order:
    # cfg80211 -> mac80211 -> core -> pci (bus) -> 8852b_common -> 8852b (chip)
    # -> 8852be (pci glue). cfg80211/mac80211 build as GKI modules but ship
    # nowhere by default (not in system_dlkm), so the rtw89 stack has no 802.11
    # core to bind against; ship them here in vendor_dlkm, before rtw89.
    # K3-only; no matching PCIe device on K1 boards.
    "cfg80211.ko",
    "mac80211.ko",
    "rtw89_core.ko",
    "rtw89_pci.ko",
    "rtw89_8852b_common.ko",
    "rtw89_8852b.ko",
    "rtw89_8852be.ko",
    # I2C additional
    "i2c-k1x.ko",
    # SPI
    "k1x-spi.ko",
    "spi-k1x-qspi.ko",
    # PCIe
    "pci-pwrctrl-core.ko",
    "pci-pwrctrl-generic.ko",
    # K3 PCIe PHY (compat spacemit,k3-pcie-phy) must load before the shared
    # K1 RC driver so phy_init() in the RC probe finds the provider. K3-only,
    # no-op on K1 boards (no matching DT node).
    "phy-k3-pcie.ko",
    "pcie-spacemit-k1.ko",
    # PWM
    "pwm-dwc-k1pro.ko",
    # Thermal
    "k1x-thermal.ko",
    # GPU (PowerVR upstream imagination driver) + dependencies
    "drm_gpuvm.ko",
    "drm_exec.ko",
    "gpu-sched.ko",
    "powervr.ko",
    # Power Domains
    # CPUfreq — builtin (=y), not module
    # USB
    # Combo PHY USB3+PCIe (must load before dwc3 for xHCI USB 3.0 init)
    "phy-spacemit-k1x-combphy.ko",
    "dwc3-spacemit.ko",
    "phy-k1x-ci-usb2.ko",
    "phy-k1x-ci-otg.ko",
    "ehci-k1x-ci.ko",
    "onboard_usb_dev.ko",
    "k1x_udc_core.ko",
    # phy-k3-usb3.ko + fusb301.ko moved to VENDOR_BOOT_MODULES so recovery
    # has USB3 / Type-C in first stage.
    # Bluetooth — Realtek RTL8852B over USB (btusb). btusb hard-selects
    # btintel; BT_HCIBTUSB_RTL (default y) pulls btrtl for the RTL8852B.
    # net/bluetooth/*.ko + btbcm.ko are GKI-provided. K3-only (USB BT).
    "btintel.ko",
    "btrtl.ko",
    "btusb.ko",
    # Media/Camera
    "cam_plat_v2.ko",
    "cam_ccic_v2.ko",
    "cam_vi_v2.ko",
    "cam_isp_v2.ko",
    "cam_cpp_v2.ko",
    "cam_sensor_v2.ko",
    "amvx.ko",
    "svivi.ko",
    "vcam_dbg.ko",
    "snd-soc-es8326.ko",
    "snd-soc-k1-i2s.ko",
    # K3 DP-audio RI2S CPU DAI — K3-only, no-op on K1 (no DT node)
    "snd-soc-k3-ri2s.ko",
    "snd-soc-simple-card.ko",
    "snd-soc-simple-card-utils.ko",
]

